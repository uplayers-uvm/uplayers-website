---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('shows')).map((show) => ({ params: { id: show.id }, props: { show } }));
}
const { show } = Astro.props;
const d = show.data;
const { Content } = await render(show);
---
<Base title={d.title}>
  {d.image && <div class="show-hero"><img src={d.image} alt={`${d.title} cast photo`} /></div>}
  <article class="wrap narrow section">
    <p class="eyebrow">{d.season}</p>
    <h1>{d.title}</h1>
    {d.playwright && <p class="muted byline">by {d.playwright}</p>}
    {(d.dates || d.venue) && (
      <div class="details">
        {d.dates && <p><strong>When:</strong> {d.dates}</p>}
        {d.venue && <p><strong>Where:</strong> {d.venue}</p>}
        {d.ticket_url && d.featured && <a class="btn primary" href={d.ticket_url}>Buy tickets</a>}
      </div>
    )}
    <div class="prose"><Content /></div>
    <p><a class="link" href="/shows">← All shows</a></p>
  </article>
</Base>
