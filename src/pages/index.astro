---
import Base from '../layouts/Base.astro';
import ShowCard from '../components/ShowCard.astro';
import Gallery from '../components/Gallery.astro';
import EventCard from '../components/EventCard.astro';
import { showsByDate, upcomingEvents, published, fmtDate } from '../lib/content';
import site from '../data/site.json';
const shows = await showsByDate();
const { upcoming } = await upcomingEvents();
const news = (await published('news')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
const featured = shows.find((s) => s.data.featured);
const recent = shows.filter((s) => s !== featured).slice(0, 3);
const withPhotos = shows.find((s) => s.data.gallery && s.data.gallery.length);
const join = site.mailing_list_url || `mailto:${site.email}?subject=Add%20me%20to%20the%20UPlayers%20mailing%20list`;
---
<Base>
  <section class="hero">
    <div class="wrap hero-split">
      <div class="hero-text">
        <p class="eyebrow light">{site.tagline}</p>
        <h1>{site.hero_heading}</h1>
        <p class="hero-sub">Two main stage shows a season, and a place for everyone on (or behind) the stage.</p>
        <div class="actions">
          <a class="btn primary" href="/join">Get involved</a>
          <a class="btn ghost" href={join}>Join our mailing list</a>
        </div>
      </div>
      {site.hero_image && (
        <figure class="hero-photo">
          <img src={site.hero_image} alt="University Players cast members peeking through a red stage curtain" />
        </figure>
      )}
    </div>
  </section>

  {featured && (
    <section class="wrap section">
      <div class="now-playing">
        {featured.data.image
          ? <img src={featured.data.image} alt="" />
          : <div class="now-playing-placeholder"><img src="/images/logo.png" alt="" /></div>}
        <div>
          <p class="eyebrow">Now playing · {featured.data.season}</p>
          <h2>{featured.data.title}</h2>
          {featured.data.playwright && <p class="muted byline">by {featured.data.playwright}</p>}
          {featured.data.dates && <p><strong>{featured.data.dates}</strong></p>}
          {featured.data.venue && <p class="muted">{featured.data.venue}</p>}
          <div class="actions">
            {featured.data.ticket_url && <a class="btn primary" href={featured.data.ticket_url}>Buy tickets</a>}
            <a class="btn outline" href={`/shows/${featured.id}`}>About the show</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {upcoming.length > 0 && (
    <section class="wrap section" data-upcoming-section>
      <div class="section-head">
        <h2>Upcoming events</h2>
        <a href="/events" class="link">All events →</a>
      </div>
      <div class="event-list" data-upcoming-list>{upcoming.slice(0, 3).map((e) => <EventCard event={e} />)}</div>
    </section>
  )}

  <section class="wrap section intro">
    <h2>Who we are</h2>
    <p class="lead">{site.intro}</p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Recent productions</h2>
      <a href="/shows" class="link">All shows →</a>
    </div>
    <div class="show-grid">{recent.map((s) => <ShowCard show={s} />)}</div>
  </section>

  {news.length > 0 && (
    <section class="wrap section">
      <div class="section-head">
        <h2>Latest news</h2>
        <a href="/news" class="link">All news →</a>
      </div>
      <ul class="past-list">
        {news.map((p) => <li><a href={`/news/${p.id}`}>{p.data.title}</a> <span class="muted">· {fmtDate(p.data.date, false)}</span></li>)}
      </ul>
    </section>
  )}

  {withPhotos && (
    <section class="wrap section">
      <div class="section-head">
        <h2>From the gallery</h2>
        <a href="/gallery" class="link">All photos →</a>
      </div>
      <Gallery photos={withPhotos.data.gallery!.slice(0, 8)} title={withPhotos.data.title} />
    </section>
  )}

  <section class="band">
    <div class="wrap band-inner">
      <div>
        <h2>Two main stage shows a season.</h2>
        <p>Acting, directing, writing, tech, design. Find your place on (or behind) the stage.</p>
      </div>
      <a class="btn primary" href="/join">Join the club</a>
    </div>
  </section>
</Base>
