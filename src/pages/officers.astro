---
import Base from '../layouts/Base.astro';
import data from '../data/officers.json';
const initials = (name: string) => { const w = name.replace(/\(.*?\)/g, ' ').split(/\s+/).filter((x) => /^[A-Za-z]/.test(x)); return ((w[0]?.[0] ?? '') + (w.length > 1 ? w[w.length - 1][0] : '')).toUpperCase(); };
---
<Base title="Officers">
  <section class="page-head wrap">
    <p class="eyebrow">{data.year} Board</p>
    <h1>Our Officers</h1>
    {data.note && <p class="lead">{data.note}</p>}
  </section>
  <section class="wrap section">
    <ul class="officer-grid">
      {data.officers.map((o) => (
        <li class="officer">
          {o.photo
            ? <img class="officer-photo" src={o.photo} alt={o.name} loading="lazy" />
            : <div class="officer-photo officer-initials" aria-hidden="true">{initials(o.name)}</div>}
          <div>
            <p class="eyebrow">{o.role}</p>
            <p class="officer-name">{o.name}</p>
            {(o.pronouns || o.major) && <p class="officer-major">{[o.pronouns, o.major].filter(Boolean).join(' · ')}</p>}
            {o.favorite_show && <p class="officer-bio"><strong>Favorite past show:</strong> {o.favorite_show}</p>}
            {o.fun_fact && <p class="officer-bio"><strong>Fun fact:</strong> {o.fun_fact}</p>}
            {o.bio && <p class="officer-bio">{o.bio}</p>}
            {o.email && <a href={`mailto:${o.email}`}>{o.email}</a>}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
