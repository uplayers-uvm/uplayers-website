---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { upcomingEvents } from '../../lib/content';
// Events are split into upcoming/past when the site is built, and again in the visitor's
// browser (see Base.astro), so an event moves to "Past events" the moment it ends.
const { upcoming, past } = await upcomingEvents();
---
<Base title="Events">
  <section class="page-head wrap">
    <p class="eyebrow">What's on</p>
    <h1>Upcoming Events</h1>
    <p class="lead">Shows, auditions, meetings, workshops and socials. Everyone is welcome.</p>
    <p><a class="link" href="/events.ics">📅 Add all UPlayers events to your calendar</a></p>
  </section>
  <section class="wrap section">
    <div class="event-list" data-upcoming-list>{upcoming.map((e) => <EventCard event={e} />)}</div>
    <p class="muted empty-note" data-empty-note hidden={upcoming.length > 0}>
      Nothing scheduled right now. Follow us on Instagram or join the mailing list to hear about what's next!
    </p>
  </section>
  <section class="wrap section past-events" data-past-section hidden={past.length === 0}>
    <h2>Past events</h2>
    <div class="event-list past" data-past-list>{past.map((e) => <EventCard event={e} />)}</div>
  </section>
</Base>
