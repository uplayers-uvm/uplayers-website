---
import '../styles/global.css';
import { published } from '../lib/content';
import site from '../data/site.json';
interface Props { title?: string; description?: string }
const { title, description = site.intro.slice(0, 155) } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const extra = (await published('pages')).filter((p) => p.data.show_in_menu)
  .sort((a, b) => a.data.menu_order - b.data.menu_order)
  .map((p) => ({ href: `/${p.id}`, label: p.data.title }));
const hasNews = (await published('news')).length > 0;
const menu = [
  { href: '/shows', label: 'Shows' },
  { href: '/events', label: 'Events' },
  ...(hasNews ? [{ href: '/news', label: 'News' }] : []),
  { href: '/gallery', label: 'Gallery' },
  { href: '/officers', label: 'Officers' },
  ...extra,
];
const banner = (site as any).announcement;
const path = Astro.url.pathname.replace(/\/$/, '');
// THEME=uvm builds the UVM-branded version (deployed to a separate, unlisted preview address).
const uvm = import.meta.env.PUBLIC_THEME === 'uvm';
---
<!doctype html>
<html lang="en" class={uvm ? 'theme-uvm' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {uvm
    ? <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,700;1,500&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    : <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />}
  {uvm && <meta name="robots" content="noindex, nofollow" />}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {banner?.enabled && banner?.text && (
    <div class="announcement">
      <div class="wrap">
        {banner.link ? <a href={banner.link}>{banner.text} →</a> : <span>{banner.text}</span>}
      </div>
    </div>
  )}
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand">
        <img src="/images/logo.png" alt="" width="44" height="44" />
        <span>University Players</span>
      </a>
      <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Open menu" />
      <label for="menu-toggle" class="menu-button" aria-hidden="true"><span></span></label>
      <nav aria-label="Main">
        {menu.map((m) => <a href={m.href} aria-current={path === m.href ? 'page' : undefined}>{m.label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="footer-name">{site.name}</p>
        <p class="muted">{site.tagline}</p>
      </div>
      <div class="footer-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.mailing_list_url && <a href={site.mailing_list_url}>Mailing list</a>}
        {(site as any).suggestion_box_url && <a href={(site as any).suggestion_box_url}>Suggestion box</a>}
        {site.instagram && <a href={site.instagram}>Instagram</a>}
        {site.facebook && <a href={site.facebook}>Facebook</a>}
        {site.youtube && <a href={site.youtube}>YouTube</a>}
      </div>
    </div>
    {uvm && (
      <div class="wrap uvm-footer">
        <p>The University Players is a student-run organization at the <a href="https://www.uvm.edu">University of Vermont</a>. The content of this site is the responsibility of the organization and does not necessarily reflect the views of the University.</p>
        <p><a href="https://www.uvm.edu/accessibility-services">Accessibility</a> · <a href="https://www.uvm.edu/compliance/website-privacy-policy/terms-use">Website Privacy Policy</a></p>
      </div>
    )}
  </footer>
  <script>
    // Move events that have ended into "Past events" (or drop them from home-page lists),
    // so the site stays correct between rebuilds. Times are compared in Vermont time.
    const now = new Date().toLocaleString('sv-SE', { timeZone: 'America/New_York' }).slice(0, 16).replace(' ', 'T');
    const pastList = document.querySelector<HTMLElement>('[data-past-list]');
    document.querySelectorAll<HTMLElement>('[data-upcoming-list]').forEach((list) => {
      [...list.querySelectorAll<HTMLElement>('[data-ends]')].forEach((el) => {
        if (el.dataset.ends! >= now) return;
        if (pastList) { pastList.prepend(el); pastList.closest<HTMLElement>('[data-past-section]')!.hidden = false; }
        else el.remove();
      });
      if (!list.children.length) {
        list.closest('[data-upcoming-section]')?.remove();
        document.querySelectorAll<HTMLElement>('[data-empty-note]').forEach((n) => (n.hidden = false));
      }
    });
  </script>
</body>
</html>
